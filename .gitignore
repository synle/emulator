# =====================================================================
# Emulator docs repo — things we should never check in
# =====================================================================

# --- macOS -----------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
.fseventsd
Icon?

# --- Windows ---------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Linux -----------------------------------------------------------
.Trash-*
.fuse_hidden*
.nfs*

# --- Node / JS tooling (Prettier, etc.) ------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.yarn/
.npm/

# --- Python (in case future tooling) ---------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Editors / IDEs --------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.settings/
.classpath

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs scratch
.#*
\#*#

# --- Environment / secrets ------------------------------------------
.env
.env.local
.env.*.local
.envrc
*.pem
*.key
credentials.json
secrets.*

# --- Backup archives produced by scripts/*.sh -----------------------
# These are the output of the backup scripts — commit intentionally by
# passing `git add -f` if you ever need to.
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
*.tgz
*.zip
*.7z
*.rar

# --- Logs ------------------------------------------------------------
*.log
logs/

# --- Scratch / tmp ---------------------------------------------------
tmp/
temp/
.cache/
*.bak
*.orig
*.rej

# --- Emulator runtime junk (in case someone runs emulators from here) -
# Keep the repo from accidentally swallowing large binary assets.
*.nes
*.sfc
*.smc
*.n64
*.z64
*.v64
*.gb
*.gbc
*.gba
*.nds
*.3ds
*.cia
*.iso
*.bin
*.cue
*.chd
*.wbfs
*.rvz
*.gcm
*.wud
*.wux
*.wua
*.nsp
*.xci
*.pbp
*.cso
*.vpk
*.pup
prod.keys
title.keys
